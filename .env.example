# Copia este ficheiro para `.env` e preenche os valores.
# O `.env` está no .gitignore; nunca faças commit de segredos.

# Obrigatória para adicionar e coletar canais.
YOUTUBE_API_KEY=

# Opcional: caminho alternativo para a base de dados SQLite.
# YTA_DB_PATH=/caminho/para/yta.db

# Opcional: classificação experimental via OpenCode.
# OPENCODE_BIN=opencode
# OPENCODE_MODEL=nome-do-modelo
